<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="bp" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.MainGuiController">
   <top>
      <MenuBar fx:id="menuBar" BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
                    <MenuItem fx:id="menuItem1" mnemonicParsing="false" text="Producto" />
                    <MenuItem fx:id="menuItem2" mnemonicParsing="false" text="Close" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <center>
      <TabPane fx:id="tabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="ALL_TABS" BorderPane.alignment="CENTER">
        <tabs>
          <!-- Pantalla de bienvenida (no se puede cerrar) -->
          <Tab fx:id="tabPrincipal" text="Inicio" closable="false">
            <content>
              <StackPane styleClass="bienvenida">
                <children>
                  <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="620.0" spacing="12.0" styleClass="tarjeta-bienvenida">
                    <children>
                      <Label styleClass="titulo-bienvenida" text="Bienvenida a Coolbox" />
                      <Label fx:id="lblUsuario" styleClass="subtitulo-bienvenida" text="Hola" />
                      <Separator />
                      <Label styleClass="pregunta-bienvenida" text="¿Qué quieres hacer hoy? Elige una opción:" />
                      <FlowPane fx:id="panelAccesos" alignment="CENTER" hgap="10.0" prefWrapLength="560.0" vgap="10.0" />
                      <Label styleClass="consejo-bienvenida" text="También puedes usar el menú de arriba. Cada pantalla se abre en su propia pestaña y la cierras con la X." wrapText="true" />
                    </children>
                    <padding>
                      <Insets bottom="24.0" left="30.0" right="30.0" top="24.0" />
                    </padding>
                  </VBox>
                </children>
              </StackPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </center>
</BorderPane>
