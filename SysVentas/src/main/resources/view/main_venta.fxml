<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="miContenedor" prefHeight="470.0" prefWidth="840.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.VentaController">
    <children>
        <VBox spacing="5.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
            <children>

                <!-- ===== CLIENTE (GridPane 6 x 2) ===== -->
                <AnchorPane>
                    <children>
                        <GridPane hgap="5.0" vgap="3.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="90.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="25.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="DNI/Ruc de cliente:" />
                                <TextField fx:id="autocompCliente" GridPane.rowIndex="1" />
                                <Button fx:id="btnFormCliente" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Buscar" GridPane.columnIndex="1" GridPane.rowSpan="2" />
                                <Label text="DNI/RUC" GridPane.columnIndex="2" />
                                <TextField fx:id="dniRuc" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <Label text="Nombre/Razon Social:" GridPane.columnIndex="3" />
                                <TextField fx:id="razonSocial" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                <Label text="Dirección:" GridPane.columnIndex="4" />
                                <TextField fx:id="txtDireccion" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                                <Button fx:id="btnRegCliente" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Add" GridPane.columnIndex="5" GridPane.rowSpan="2" />
                            </children>
                        </GridPane>
                    </children>
                </AnchorPane>

                <!-- ===== PRODUCTO (GridPane 8 x 2) ===== -->
                <AnchorPane>
                    <children>
                        <GridPane hgap="5.0" vgap="3.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="130.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="130.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="90.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="75.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="85.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="95.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="75.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="25.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Buscar Producto:" />
                                <TextField fx:id="autocompProducto" GridPane.rowIndex="1" />
                                <Label text="Producto:" GridPane.columnIndex="1" />
                                <TextField fx:id="nombreProducto" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Código" GridPane.columnIndex="2" />
                                <TextField fx:id="codigoPro" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <Label text="Stock" GridPane.columnIndex="3" />
                                <TextField fx:id="stockPro" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                <Label text="Cantidad" GridPane.columnIndex="4" />
                                <TextField fx:id="cantidadPro" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                                <Label text="P.Unit" GridPane.columnIndex="5" />
                                <TextField fx:id="punitPro" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                                <Label text="P. Total" GridPane.columnIndex="6" />
                                <TextField fx:id="preTPro" GridPane.columnIndex="6" GridPane.rowIndex="1" />
                                <Button fx:id="btnRegCarrito" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Add" GridPane.columnIndex="7" GridPane.rowSpan="2" />
                            </children>
                        </GridPane>
                    </children>
                </AnchorPane>

                <!-- ===== CARRITO (TableView) ===== -->
                <AnchorPane VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tableView" prefHeight="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                    </children>
                </AnchorPane>

                <!-- ===== TOTALES (GridPane 5 x 2) ===== -->
                <AnchorPane>
                    <children>
                        <GridPane hgap="5.0" vgap="3.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="160.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="160.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="160.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="160.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="25.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="B. Imponible" />
                                <TextField fx:id="txtBaseImp" editable="false" GridPane.rowIndex="1" />
                                <Label text="IGV" GridPane.columnIndex="1" />
                                <TextField fx:id="txtigv" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Descuento" GridPane.columnIndex="2" />
                                <TextField fx:id="txtDescuento" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <Label text="Importe T. S/." GridPane.columnIndex="3" />
                                <TextField fx:id="txtImporteT" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                <Button fx:id="btnRegVenta" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="R. Venta" GridPane.columnIndex="4" GridPane.rowSpan="2" />
                            </children>
                            <padding>
                                <Insets bottom="5.0" top="5.0" />
                            </padding>
                        </GridPane>
                    </children>
                </AnchorPane>

            </children>
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
