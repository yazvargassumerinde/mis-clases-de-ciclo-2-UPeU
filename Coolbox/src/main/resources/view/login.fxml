<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.LoginController">
    <children>
        <VBox layoutX="14.0" layoutY="14.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
            <children>
                <!-- Encabezado estilo Van Gogh -->
                <StackPane styleClass="login-cabecera">
                    <children>
                        <ImageView fitHeight="130.0" fitWidth="380.0" pickOnBounds="true" preserveRatio="false">
                            <image>
                                <Image url="@../img/vg-login.png" />
                            </image>
                        </ImageView>
                        <VBox alignment="CENTER" spacing="2.0">
                            <children>
                                <Label styleClass="login-titulo" text="Coolbox" />
                                <Label styleClass="login-subtitulo" text="Ventas y compras · Juliaca" />
                            </children>
                        </VBox>
                    </children>
                </StackPane>
                <Label maxWidth="1.7976931348623157E308" alignment="CENTER" styleClass="login-ayuda" text="Ingresa tu usuario y clave para continuar">
                    <VBox.margin>
                        <Insets bottom="8.0" top="10.0" />
                    </VBox.margin>
                </Label>
                <GridPane vgap="6.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <AnchorPane styleClass="login-campo" GridPane.columnSpan="2147483647">
                            <children>
                                <Label layoutX="74.0" layoutY="6.0" text="Usuario" />
                                <TextField fx:id="txtUsuario" promptText="Ej: yazminvs" layoutX="151.0" layoutY="4.0" />
                            </children>
                            <GridPane.margin>
                                <Insets left="5.0" right="5.0" />
                            </GridPane.margin>
                        </AnchorPane>
                        <AnchorPane styleClass="login-campo" GridPane.columnSpan="2147483647" GridPane.rowIndex="1">
                            <children>
                                <Label layoutX="74.0" layoutY="8.0" text="Clave" />
                                <PasswordField fx:id="txtClave" promptText="Tu clave" layoutX="151.0" layoutY="3.0" prefHeight="22.0" prefWidth="148.0">
                                    <padding>
                                        <Insets bottom="5.0" />
                                    </padding>
                                </PasswordField>
                            </children>
                            <GridPane.margin>
                                <Insets left="5.0" right="5.0" />
                            </GridPane.margin>
                        </AnchorPane>
                    </children>
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </GridPane>
                <AnchorPane>
                    <children>
                        <GridPane layoutX="14.0" layoutY="14.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" defaultButton="true" mnemonicParsing="false" onAction="#login" text="Ingresar">
                                    <GridPane.margin>
                                        <Insets right="5.0" />
                                    </GridPane.margin>
                                </Button>
                                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" cancelButton="true" mnemonicParsing="false" onAction="#logout" text="Cerrar" GridPane.columnIndex="1">
                                    <GridPane.margin>
                                        <Insets left="5.0" />
                                    </GridPane.margin>
                                </Button>
                            </children>
                        </GridPane>
                    </children>
                </AnchorPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
